# Absolute origin of the deployed site (no trailing slash). Used for canonical
# URLs, sitemap, Open Graph and structured data. Defaults to localhost.
NEXT_PUBLIC_SITE_URL=https://example.com

# Portfolio assistant (server-side only; never expose to the browser).
# Create a key in the Anthropic Console and set a monthly spend limit there.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-5-5; claude-opus-5-5 is stronger but ~40x pricier.
ANTHROPIC_MODEL=
